<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Family Help"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/setupGroup"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setup — helper only"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control is OFF"
            android:textStyle="bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 1 — allow the control permission to be enabled:"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.  Open App Info (Allow restricted settings)"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 2 — turn the switch ON for Family Help:"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />
        <Button
            android:id="@+id/accBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2.  Turn ON control"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connection"
            android:textStyle="bold"
            android:layout_marginTop="18dp" />
        <EditText
            android:id="@+id/relay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Relay URL (https://yourname.deno.dev)"
            android:inputType="textUri"
            android:autofillHints="" />
        <EditText
            android:id="@+id/room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room code for THIS person (e.g. RAMESH1)"
            android:inputType="textCapCharacters"
            android:autofillHints="" />
        <EditText
            android:id="@+id/helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your name"
            android:inputType="textCapWords"
            android:autofillHints="" />
        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginTop="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="After saving, they only ever see one big button."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeGroup"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/bigLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the big button to let your family help with your phone."
            android:textSize="22sp"
            android:gravity="center"
            android:paddingTop="30dp"
            android:paddingBottom="30dp" />

        <Button
            android:id="@+id/bigBtn"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:text="START"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingTop="24dp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
